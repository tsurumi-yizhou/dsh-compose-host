{
  "name": "@deepseek-ai/dsh-skill-filesystem",
  "description": "Local filesystem skill provider for the DeepSeek Harness",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/skill/skill-filesystem"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-fs": "0.2.2-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.3",
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "dependencies": {
    "chokidar": "6.0.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-fs": "0.2.2-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.3",
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "private": true
}
